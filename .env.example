# Dashboard auth (set a long random string in production)
AUTH_SECRET=change-me-to-a-long-random-secret

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
ALLOWED_TELEGRAM_USER_ID=123456789

# Gemini (Google AI Studio). Keys rotate automatically when one hits quota.
# Prefer comma-separated list:
GEMINI_API_KEYS=key_one,key_two
# Or numbered keys:
# GEMINI_API_KEY=key_one
# GEMINI_API_KEY_2=key_two
GEMINI_MODEL=gemini-flash-lite-latest

# Optional during early testing
# SKIP_NOTEBOOKLM=1

# Facebook Login (OAuth) — platform app credentials (users connect Pages in the UI)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# FACEBOOK_GRAPH_VERSION=v22.0

# Local defaults — change these for Vercel + Render:
PUBLIC_API_URL=http://127.0.0.1:8787
FRONTEND_URL=http://127.0.0.1:5173
# CORS_ORIGINS=https://extra-preview.vercel.app
#
# Production example:
#   PUBLIC_API_URL=https://marketing-agent-api.onrender.com
#   FRONTEND_URL=https://your-app.vercel.app
# Meta → Facebook Login → Valid OAuth Redirect URIs:
#   https://marketing-agent-api.onrender.com/api/integrations/facebook/callback
#   http://127.0.0.1:8787/api/integrations/facebook/callback

# NotebookLM video defaults (short = TikTok/Reels-style vertical)
# Formats: short | brief | explainer | cinematic
NOTEBOOKLM_VIDEO_FORMAT=short
NOTEBOOKLM_VIDEO_STYLE=auto_select
NOTEBOOKLM_VIDEO_LANGUAGE=en
VIDEO_POLL_INTERVAL_SECONDS=30
VIDEO_TIMEOUT_MINUTES=45
